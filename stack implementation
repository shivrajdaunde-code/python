class Stack:  # A class to represent Stack.

    def __init__(self, size):
        self.stack = []  # Initialize an empty stack with size.
        self.size = size  # Maximum allowed capacity

    def push(self, item):  # Add an element to the top of the stack.
        if len(self.stack) == self.size:
            print("Stack Overflow")
        else:
            self.stack.append(item)  # Append item to the end (top of stack)
            print(item, "pushed into stack")

    def pop(self):  # Remove and return the top element of the stack.
        if len(self.stack) == 0:
            print("Stack Underflow")
        else:
            print(self.stack.pop(), "popped from stack")

    def peek(self):  # View the top element of the stack.
        if len(self.stack) == 0:
            print("Stack is empty")
        else:
            print("Top element:", self.stack[-1])

    def display(self):  # Display all elements currently in the stack.
        if len(self.stack) == 0:
            print("Stack is empty")
        else:
            print("Stack:", self.stack)
